# Copy to .env (cp .env.example .env) and adjust. Used for local development.

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://opengrowth:opengrowth@localhost:5432/opengrowth_affiliate"

# Week and month cutoffs (Monday 00:00 / 1st of the month) use this time zone.
APP_TIMEZONE="America/New_York"

# Public address used in referral links. Empty = use the address in the browser.
APP_URL=""

# Where uploads (payment screenshots, ID photos) are saved when S3_BUCKET is empty.
STORAGE_DIR="./storage"

# Optional: store uploads in AWS S3 instead of on disk.
S3_BUCKET=""
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
