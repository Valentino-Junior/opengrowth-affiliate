# Copy to .env on the VPS and fill in. Never commit the real .env.

# The app's address: a subdomain of the main site (DNS A record "affiliate" → the VPS IP). Caddy gets its HTTPS certificate.
DOMAIN=affiliate.opengrowthofficial.com
APP_URL=https://affiliate.opengrowthofficial.com

# Database password for the bundled PostgreSQL (long and random: openssl rand -base64 32)
POSTGRES_PASSWORD=

APP_TIMEZONE=America/New_York

# Email (confirmation codes, approval emails) through Resend. See DEPLOY.md step 9.
RESEND_API_KEY=
EMAIL_FROM=Opengrowth <no-reply@affiliate.opengrowthofficial.com>

# Uploads (payment screenshots, ID photos). Leave S3_BUCKET empty to keep them on the VPS disk.
S3_BUCKET=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
